<% @advertisement = @url_redirection_view_model.advertisement %>

<div class="reservation redirection-section">
  <div class="reservation">
    <% case @url_redirection_view_model.status %>
    <% when :success %>
      <%= form_with url: go_redirect_path, method: :post, data: { turbo: false }, html: { style: "display: inline-block;" } do %>
        <%= hidden_field_tag :id, @url_redirection_view_model.url.id %>
        <%= submit_tag "Continue to your link", class: "cta-btn" %>
      <% end %>
    <% when :not_found %>
        <%= @url_redirection_view_model.message %>
    <% when :gone %>
        <%= @url_redirection_view_model.message %>
    <% end %>
  </div>
</div>

<section id="reservation">
    <div class="reservation">
    <section id="menu">
        <div class="menu-grid">
            <div class="menu-item">
                <div class="menu-item-content advertisement-detail-label">
                  <h3><%= @advertisement.label %></h3>
                </div>
                <img class="advertisement" src="<%= @advertisement.image_url %>" alt="<%= @advertisement.label %>" class="menu-item-image">
                
            </div>
        </div>
    </section>
    </div>
</section>