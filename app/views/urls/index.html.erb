<section class="url-shortener">
  <div class="reservation">
    <h2>Shorten a URL</h2>
    <div>
      <%= form_with url:urls_path, scope: :url_form, local:true, html: { class: "reservation-form" }, data: { turbo: false } do |f| %>
        <div class="form-group">
          <%= f.text_field :long_url, value: @url_form.url&.long_url, placeholder: "Put your URL here https://example.com" %> <br />
        </div>
        <%= f.submit "Shorten URL", class: "submit-btn" %>
      <% end %>
    <div>

    <div class="url-short-message-box">
    <% if @url_form.message.present? %>
      <p> <%= @url_form.message %> </p>

      <% if @url_form.success %>
        <div class="short-url-wrapper"> 
          <a id="short-url" target="_blank" href="<%= @url_form.url.short_url %>"><%= @url_form.url.short_url %></a>
          <button id="copy-btn" class="copy-btn">Copy</button>
        </div>
        <p> Your url will be expired by <%= @url_form.url.expiration_date %> </p>

      <% else %>
        <% if @url_form.url.errors[:long_url].any? %>
          <div style="color: red;">
              <%= @url_form.url.errors[:long_url].join(', ') %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    </div>
  </div>
</section>

<section id="menu">
    <h2>Advertisements</h2>
    <div class="menu-grid">
        <% @url_form.advertisements.each do |ad| %>
        <div class="menu-item">
            <img src="<%= ad.image_url %>" alt="<%= ad.label %>" class="menu-item-image">
            <div class="menu-item-content">
                <h3><%= ad.label %></h3>
                <button class="ingredients-btn" onclick="showIngredients('truffle-risotto')">View Ingredients</button>
            </div>
        </div>
        <% end %>
    </div>
</section>